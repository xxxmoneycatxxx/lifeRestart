{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "人生重开模拟器",
    "version": "3.0.0",
    "identifier": "io.syaro.liferestart",
    "build": {
        "beforeDevCommand": "pnpm dev:tauri",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build:tauri",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "人生重开模拟器",
                "width": 540,
                "height": 960,
                "minWidth": 360,
                "minHeight": 640,
                "resizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ]
    }
}
